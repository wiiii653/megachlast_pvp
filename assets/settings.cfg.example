# Example settings for megachlast_pvp (assets/settings.cfg)
# Lines are KEY=VALUE, comments with '#'
# Available keys:
# TARGET_SCORE — int
# P_SPEED — float (player speed px/sec)
# BULLET_SPEED — float (px/sec)
# BULLET_TTL — float (seconds)
# HIT_R — float (collision radius)
# DAMAGE — float (energy per hit)
# FIRE_CD_P1_FRAMES — int (frames between shots for Player 1)
# FIRE_CD_P2_FRAMES — int (frames between shots for Player 2)
TARGET_SCORE=5
# Best-of-three by default: first player to win two rounds wins the match.
ROUNDS_TO_WIN=2
P_SPEED=120.0
BULLET_SPEED=190.0
BULLET_TTL=3.5
HIT_R=5.0
# Lower damage to lengthen fights and reduce single-shot kills
DAMAGE=10.0
# Shot cooldown per player (lower = faster firing)
FIRE_CD_P1_FRAMES=9
FIRE_CD_P2_FRAMES=9
# Bot enabled by default on startup (0/1)
BOT_ENABLED=0
# Bot difficulty: EASY, MEDIUM, HARD
BOT_DIFFICULTY=MEDIUM

# Optional bot tuning overrides (uncomment to enable per-difficulty or per-behaviour tuning)
# Values: floats; negative value or omitted = use built-in defaults
# Example usage: BOT_AIM_LEAD_EASY=0.25

# BOT_AIM_LEAD_EASY=0.18
# BOT_AIM_LEAD_MED=0.6
# BOT_AIM_LEAD_HARD=1.05

# BOT_DODGE_ZONE=60.0
# BOT_DODGE_X_THR=8.0
# BOT_ALIGN_TOL=8.0
# BOT_FIRE_PROB=0.9
# BOT_REACTION=0.95
# BOT_POWERUP_INTEREST=0.6
# BOT_STRAFE_LO=0.8
# BOT_STRAFE_HI=2.0
# BOT_BOMB_FEAR=42.0

# Audio defaults (percent)
MUSIC_VOLUME=90
SFX_VOLUME=90
MUTE=0

# Graphics defaults
# Window scale controls the windowed resolution from the 640x400 internal render target:
# 2=1280x800, 3=1920x1200, 4=2560x1600, 5=3200x2000, 6=3840x2400.
# Fullscreen uses the desktop video mode instead.
WINDOW_SCALE=4
# Game canvas ratio. 16:10 is 640x400; 16:9 is a true 640x360 arena.
SCREEN_ASPECT=16:10
# Master cosmetic post-processing toggle. The --no-postfx CLI flag overrides this for a session.
POSTFX_ENABLED=1
# Individual cosmetic post-processing toggles.
SCANLINES=1
VIGNETTE=1
CHROMATIC_ABERRATION=1
COPPER_BARS=1

# Controller setup: SFML joystick slots (0-7), or -1 for keyboard-only.
# Defaults assign the first two connected controllers to P1 and P2.
P1_CONTROLLER=0
P2_CONTROLLER=1

# ── Control profiles (Settings -> Controls) ──────────────────────────────────
# Independent, persistent bindings for Keyboard, Xbox, PS4, PS5 and a generic
# joystick fallback. Each line is a semicolon-separated list of ACTION:BINDING
# pairs. Omitting an action keeps its default; NONE leaves it unbound.
#
# A BINDING is up to three physical inputs separated by '|':
#   <int>     keyboard scancode (raw SFML scancode index)
#   B<n>      joystick button index
#   AX<n>-/+  joystick axis index with direction (0=X,1=Y,6=PovX,7=PovY)
#
# Action tags: P1L/P1R/P1F, P2L/P2R/P2F (gameplay), UP/DOWN/LEFT/RIGHT/CONF/BACK
# (menu), ML/MR/P2ML/P2MR/AL/AR/START/SBACK (match setup), PAUSE/RESET/MENU
# (in-game), SETT/DONATE/FS/SAVE/LOAD/BOT/BDIFF/BDBG/PERF/MUTE/VD/VU (keyboard
# shortcuts). Pad profiles bind MVL/MVR/FIR and the menu/match-setup/game tags.
# The game writes all profiles on save; edit only what you want to change.

# Defaults (for reference):
# KEYBOARD_BINDINGS=P1L:0;P1R:3;P1F:127|25|128;P2L:87;P2R:86;P2F:131|51|132;UP:89;DOWN:88;LEFT:87;RIGHT:86;CONF:36;BACK:37;ML:0;MR:3;P2ML:87;P2MR:86;AL:16;AR:4;START:36;SBACK:37;PAUSE:40;RESET:17;MENU:37;SETT:14;DONATE:3;FS:62;SAVE:10;LOAD:11;BOT:1;BDIFF:21;BDBG:6;PERF:15;MUTE:12;VD:49;VU:50
# XBOX_BINDINGS=MVL:AX0-|AX6-;MVR:AX0+|AX6+;FIR:B0|B4|B5;UP:AX1-|AX7-;DOWN:AX1+|AX7+;LEFT:AX0-|AX6-;RIGHT:AX0+|AX6+;CONF:B0;BACK:B1;ML:AX0-|AX6-;MR:AX0+|AX6+;AL:B4;AR:B5;START:B0|B4|B5;SBACK:B1;PAUSE:B7;RESET:B6;MENU:B1
# PS4_BINDINGS=MVL:AX0-|AX6-;MVR:AX0+|AX6+;FIR:B0|B4|B5;UP:AX1-|AX7-;DOWN:AX1+|AX7+;LEFT:AX0-|AX6-;RIGHT:AX0+|AX6+;CONF:B0;BACK:B1;ML:AX0-|AX6-;MR:AX0+|AX6+;AL:B4;AR:B5;START:B0|B4|B5;SBACK:B1;PAUSE:B9;RESET:B8;MENU:B1
# PS5_BINDINGS=MVL:AX0-|AX6-;MVR:AX0+|AX6+;FIR:B0|B4|B5;UP:AX1-|AX7-;DOWN:AX1+|AX7+;LEFT:AX0-|AX6-;RIGHT:AX0+|AX6+;CONF:B0;BACK:B1;ML:AX0-|AX6-;MR:AX0+|AX6+;AL:B4;AR:B5;START:B0|B4|B5;SBACK:B1;PAUSE:B9;RESET:B8;MENU:B1
# GENERIC_BINDINGS=MVL:AX0-|AX6-;MVR:AX0+|AX6+;FIR:B0|B4|B5;UP:AX1-|AX7-;DOWN:AX1+|AX7+;LEFT:AX0-|AX6-;RIGHT:AX0+|AX6+;CONF:B0;BACK:B1;ML:AX0-|AX6-;MR:AX0+|AX6+;AL:B4;AR:B5;START:B0|B4|B5;SBACK:B1;PAUSE:B7;RESET:B6;MENU:B1

# Example: move P1 left/right to H (scancode 71) and G (scancode 74).
# KEYBOARD_BINDINGS=P1L:71;P1R:74
